{
  "manifest_version": 3,
  "name": "Review Autoreply",
  "version": "1.0",
  "description": "Automated review replies",
  "permissions": ["activeTab","scripting", "storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default icon ": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },
  "content_scripts":[
    {
      "matches":[
        "https://www.airbnb.com/hosting/*",
        "https://admin.booking.com/*",
        "https://extranet.booking.com/*",
        "https://business.google.com/*"
      ],
      "js":["content.js"]
    }
  ]
  }